# ========================================================
# PARKSMART FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# ========================================================

# Base URL of deployed backend API (used during Vite build)
# Local: http://localhost:5001/api
# Render: https://parksmart-backend.onrender.com/api
VITE_API_URL=http://localhost:5001/api

# WebSocket / Socket.IO Server URL (Optional: defaults to VITE_API_URL root)
# Local: http://localhost:5001
# Render: https://parksmart-backend.onrender.com
VITE_SOCKET_URL=http://localhost:5001
