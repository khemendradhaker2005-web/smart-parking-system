# ========================================================
# PARKSMART BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ========================================================

# Server Port (Render sets this dynamically via process.env.PORT)
PORT=5001
NODE_ENV=development

# JSON Web Token Secret (Use a strong random string in production)
JWT_SECRET=replace_with_strong_random_secret_in_production

# CORS Allowed Origins (Comma-separated list or '*' for all)
# In production on Render: https://parksmart-frontend.onrender.com
CORS_ORIGIN=*

# PostgreSQL Connection (Render Managed PostgreSQL provides DATABASE_URL)
# Option A: Single Connection String (Recommended for Render)
# DATABASE_URL=postgres://user:password@host:5432/smart_parking_db

# Option B: Individual Connection Parameters (Local development)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=smart_parking_db
DB_SSL=true
DB_POOL_MAX=10

# Database Engine Options
# Set to 'true' to force embedded SQLite (sql.js) without connecting to PostgreSQL
USE_EMBEDDED_DB=false

# Auto-seed initial demo accounts and locations on startup if table is empty
AUTO_SEED=true

# UPI Payment & QR Code Demo Settings
UPI_VPA=smartparking@icici
UPI_PAYEE_NAME=Smart Parking System
